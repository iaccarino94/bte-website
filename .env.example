# Resend (https://resend.com) — used to email form submissions to office@bteducationfund.org
RESEND_API_KEY=

# Sending address — mail.bteducationfund.org is verified in Resend, so this
# only needs to be set to override the default (e.g. a staging environment on
# an unverified domain, where it should point back to Resend's sandbox address).
RESEND_FROM_EMAIL="BTE Website <noreply@mail.bteducationfund.org>"

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Add both the production domain and any Vercel preview domains to the
# widget's allowed hostnames, or verification will silently fail on previews.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
