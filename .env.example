# Resend (https://resend.com) — used to email form submissions to office@bteducationfund.org
RESEND_API_KEY=

# Sending address — must be on a domain verified in your Resend account.
# Until a domain is verified, Resend's sandbox address only delivers to the
# Resend account owner's own email, not to office@bteducationfund.org.
RESEND_FROM_EMAIL="BTE Fund <applications@bteducationfund.org>"

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Add both the production domain and any Vercel preview domains to the
# widget's allowed hostnames, or verification will silently fail on previews.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
